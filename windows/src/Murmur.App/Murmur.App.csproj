<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net10.0, NOT net10.0-windows. Avalonia is cross-platform, and this is what
         lets the UI be built and headless-tested on macOS — the reason Avalonia was chosen
         over WPF. Windows-only code lives in Murmur.Platform.Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Murmur.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- An optional local model, folded into the exe.

       Present only if someone has put the weights in models\parakeet-v2 before publishing —
       they are gitignored and 661 MB, so CI never sees them and keeps producing the small
       exe. Publish with -p:IncludeAllContentForSelfExtract=true to get the one-file build
       that needs no separate download; without that flag these are copied beside the exe
       instead, which the app finds equally well.

       No code knows about this: AppContext.BaseDirectory\models\parakeet-v2 is already a
       search path, and in self-extract mode BaseDirectory is the extraction directory. -->
  <ItemGroup Condition="Exists('models\parakeet-v2\tokens.txt')">
    <Content Include="models\parakeet-v2\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Murmur.Core\Murmur.Core.csproj" />
    <ProjectReference Include="..\Murmur.Speech\Murmur.Speech.csproj" />
  </ItemGroup>

  <!-- The Windows platform layer targets net10.0-windows and is resolved by reflection at
       run time (see PlatformFactory). ReferenceOutputAssembly=false means it is BUILT and
       COPIED next to the app without being compiled against — which is what lets this
       project stay on plain net10.0 and therefore build and headless-test on macOS.
       Skipped entirely off Windows, where it cannot compile. -->
  <ItemGroup Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <!-- SkipGetTargetFrameworkProperties is required: without it MSBuild refuses the
         reference outright ("targets net10.0-windows, cannot be referenced by a project
         that targets .NETCoreApp") before ReferenceOutputAssembly is ever considered. -->
    <ProjectReference Include="..\Murmur.Platform.Windows\Murmur.Platform.Windows.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework"
                      Private="false" />
  </ItemGroup>

  <!-- ReferenceOutputAssembly=false suppresses the copy too, so bring the assembly across
       explicitly. PlatformFactory resolves it by name at startup. -->
  <Target Name="PublishWindowsPlatformLayer"
          BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <MSBuild Projects="..\Murmur.Platform.Windows\Murmur.Platform.Windows.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <_PlatformPublish Include="..\Murmur.Platform.Windows\bin\$(Configuration)\net10.0-windows\Murmur.Platform.Windows.dll" />
      <_PlatformPublish Include="..\Murmur.Platform.Windows\bin\$(Configuration)\net10.0-windows\NAudio*.dll" />
      <!-- Loose beside the exe rather than inside the bundle: PublishSingleFile only bundles
           assemblies the compiler knows about, and this one is deliberately invisible to it.
           The default load context probes AppContext.BaseDirectory, and Program.cs installs
           a resolver as a belt-and-braces fallback. -->
      <ResolvedFileToPublish Include="@(_PlatformPublish)">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="CopyWindowsPlatformLayer"
          AfterTargets="Build"
          Condition="'$([System.OperatingSystem]::IsWindows())' == 'true'">
    <ItemGroup>
      <PlatformLayer Include="..\Murmur.Platform.Windows\bin\$(Configuration)\net10.0-windows\Murmur.Platform.Windows.dll" />
      <PlatformLayer Include="..\Murmur.Platform.Windows\bin\$(Configuration)\net10.0-windows\NAudio*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PlatformLayer)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
